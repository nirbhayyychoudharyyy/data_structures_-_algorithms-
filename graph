# Create Graph using Adjacency Matrix

class Graph:
    def __init__(self, vertices):
        self.vertices = vertices
        self.matrix = []

        for i in range(vertices):
            row = []
            for j in range(vertices):
                row.append(0)
            self.matrix.append(row)

    # Add Edge
    def add_edge(self, u, v):
        self.matrix[u][v] = 1
        self.matrix[v][u] = 1

    # Display Adjacency Matrix
    def display(self):
        print("Adjacency Matrix:")
        for row in self.matrix:
            print(row)

    # DFS Traversal
    def dfs(self, start):
        visited = [False] * self.vertices
        self.dfs_util(start, visited)

    def dfs_util(self, vertex, visited):
        visited[vertex] = True
        print(vertex, end=" ")

        for i in range(self.vertices):
            if self.matrix[vertex][i] == 1 and not visited[i]:
                self.dfs_util(i, visited)


# Main Program
n = int(input("Enter number of intersections: "))

g = Graph(n)

while True:
    print("\n--- Road Network ---")
    print("1. Add Road")
    print("2. Display Adjacency Matrix")
    print("3. Perform DFS")
    print("4. Exit")

    choice = int(input("Enter your choice: "))

    if choice == 1:
        u = int(input("Enter first intersection: "))
        v = int(input("Enter second intersection: "))
        g.add_edge(u, v)
        print("Road added successfully.")

    elif choice == 2:
        g.display()

    elif choice == 3:
        start = int(input("Enter starting intersection: "))
        print("DFS Traversal:")
        g.dfs(start)
        print()

    elif choice == 4:
        print("Program Ended")
        break

    else:
        print("Invalid Choice")
