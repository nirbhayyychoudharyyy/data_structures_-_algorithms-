queue = []
size = 5

def enqueue():
    if len(queue) == size:
        print("Queue is Full!")
    else:
        customer = input("Enter customer name: ")
        queue.append(customer)
        print(customer, "added to queue.")

def dequeue():
    if len(queue) == 0:
        print("Queue is Empty!")
    else:
        customer = queue.pop(0)
        print(customer, "has been served.")

def display():
    if len(queue) == 0:
        print("Queue is Empty!")
    else:
        print("Customers in queue:")
        for customer in queue:
            print(customer)


while True:
    print("\n--- Ticket Booking Queue ---")
    print("1. Enqueue")
    print("2. Dequeue")
    print("3. Display")
    print("4. Exit")

    choice = int(input("Enter your choice: "))

    if choice == 1:
        enqueue()
    elif choice == 2:
        dequeue()
    elif choice == 3:
        display()
    elif choice == 4:
        print("Exiting program.")
        break
    else:
        print("Invalid choice!")
